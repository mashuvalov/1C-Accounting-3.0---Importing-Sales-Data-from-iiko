&НаСервереБезКонтекста
Функция РазобратьКонтрагента(Знач Исходное, Знач Правила = Неопределено)

	Если Правила = Неопределено Тогда
		Правила = ПравилаКонтрольногоФайла();
	КонецЕсли;
	Правило = Правила.Получить(НормализоватьИмя(Исходное));
	Если Правило <> Неопределено Тогда
		Результат = Новый Структура("Имя,Адрес,Точка", Правило.Имя, Правило.Адрес, Правило.Точка);
	Иначе
		Имя = УдалитьТелефоны(СжатьПробелы(Исходное));
		Верхний = ВРег(Имя);
		НачалоАдреса = 0;
		Для Каждого Маркер Из СтрРазделить(" УЛ.| УЛ | УЛИЦА | ПР-Т | ПРОСПЕКТ | ПЕР.| ПЕРЕУЛОК | СНТ | -СНТ ", "|") Цикл
			Позиция = СтрНайти(Верхний, Маркер);
			Если Позиция > 0 И (НачалоАдреса = 0 Или Позиция < НачалоАдреса) Тогда
				НачалоАдреса = Позиция;
			КонецЕсли;
		КонецЦикла;
		Адрес = "";
		Если НачалоАдреса > 0 Тогда
			Адрес = ОчиститьКрая(Сред(Имя, НачалоАдреса));
			Имя = ОчиститьКрая(Лев(Имя, НачалоАдреса - 1));
		КонецЕсли;
		Результат = Новый Структура("Имя,Адрес,Точка", ОчиститьКрая(Имя), Адрес, "");
	КонецЕсли;
	Данные = ДанныеИмени(Результат.Имя);
	Если ПустаяСтрока(Данные.Основа) Тогда
		ВызватьИсключение "После очистки не осталось имени контрагента: " + Исходное;
	КонецЕсли;
	// Переставляем ИП/ООО вперед, сохраняя написание очищенного имени.
	Если НЕ ПустаяСтрока(Данные.Форма) Тогда
		Для Каждого ПолнаяФорма Из СтрРазделить(
			"ОБЩЕСТВО С ОГРАНИЧЕННОЙ ОТВЕТСТВЕННОСТЬЮ|ИНДИВИДУАЛЬНЫЙ ПРЕДПРИНИМАТЕЛЬ", "|") Цикл
			ПозицияФормы = СтрНайти(ВРег(Результат.Имя), ПолнаяФорма);
			Если ПозицияФормы > 0 Тогда
				Результат.Имя = Лев(Результат.Имя, ПозицияФормы - 1) + Данные.Форма
					+ Сред(Результат.Имя, ПозицияФормы + СтрДлина(ПолнаяФорма));
			КонецЕсли;
		КонецЦикла;
		Слова = СтрРазделить(СжатьПробелы(Результат.Имя), " ", Ложь);
		ИмяБезФормы = Новый Массив;
		Для Каждого Слово Из Слова Цикл
			Если НормализоватьИмя(Слово) <> Данные.Форма Тогда
				ИмяБезФормы.Добавить(Слово);
			КонецЕсли;
		КонецЦикла;
		Результат.Имя = Данные.Форма + " " + СтрСоединить(ИмяБезФормы, " ");
	КонецЕсли;
	Результат.Вставить("ДанныеИмени", Данные);
	Результат.Вставить("ТипПоУмолчанию", ПустаяСтрока(Данные.Форма));
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ОчиститьКрая(Знач Текст)

	Текст = СжатьПробелы(Текст);
	Пока НЕ ПустаяСтрока(Текст) И СтрНайти(",;()- ", Лев(Текст, 1)) > 0 Цикл
		Текст = СокрЛП(Сред(Текст, 2));
	КонецЦикла;
	Пока НЕ ПустаяСтрока(Текст) И СтрНайти(",;()- ", Прав(Текст, 1)) > 0 Цикл
		Текст = СокрЛП(Лев(Текст, СтрДлина(Текст) - 1));
	КонецЦикла;
	Возврат Текст;

КонецФункции

&НаСервереБезКонтекста
Функция УдалитьТелефоны(Знач Текст)

	Позиция = 1;
	Пока Позиция <= СтрДлина(Текст) Цикл
		СимволНачала = Сред(Текст, Позиция, 1);
		Если СтрНайти("+78", СимволНачала) = 0 Тогда
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;
		Если Позиция > 1 И СтрНайти("0123456789", Сред(Текст, Позиция - 1, 1)) > 0 Тогда
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;
		Если СимволНачала = "+" И Сред(Текст, Позиция + 1, 1) <> "7" Тогда
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;
		Цифр = 0;
		Окончание = Позиция + ?(СимволНачала = "+", 1, 0);
		Пока Окончание <= СтрДлина(Текст) Цикл
			Знак = Сред(Текст, Окончание, 1);
			Если СтрНайти("0123456789", Знак) > 0 Тогда
				Цифр = Цифр + 1;
			ИначеЕсли СтрНайти(" ()-", Знак) = 0 Тогда
				Прервать;
			КонецЕсли;
			Если Цифр = 11 Тогда
				Прервать;
			КонецЕсли;
			Окончание = Окончание + 1;
		КонецЦикла;
		СледующийЗнак = Сред(Текст, Окончание + 1, 1);
		Если Цифр = 11 И (ПустаяСтрока(СледующийЗнак)
			Или СтрНайти("0123456789", СледующийЗнак) = 0) Тогда
			Префикс = Лев(Текст, Позиция - 1);
			Если ВРег(Прав(Префикс, 2)) = "Т." Тогда
				Префикс = Лев(Префикс, СтрДлина(Префикс) - 2);
			КонецЕсли;
			Текст = Префикс + " " + Сред(Текст, Окончание + 1);
			Позиция = 1;
		Иначе
			Позиция = Позиция + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат ОчиститьКрая(Текст);

КонецФункции

&НаСервереБезКонтекста
Функция ФИОСовместимы(Первое, Второе)

	Если Первое.Количество() = 0 Или Второе.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Первое[0] <> Второе[0] Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По Мин(Первое.Количество(), Второе.Количество()) - 1 Цикл
		А = Первое[Индекс];
		Б = Второе[Индекс];
		Если А = Б Тогда
			Продолжить;
		КонецЕсли;
		Если (СтрДлина(А) = 1 Или СтрДлина(Б) = 1) И Лев(А, 1) = Лев(Б, 1) Тогда
			Продолжить;
		КонецЕсли;
		Возврат Ложь;
	КонецЦикла;
	Возврат Истина;

КонецФункции

#КонецОбласти

#Область ИндексКонтрагентов

&НаСервереБезКонтекста
Функция ПостроитьИндексКонтрагентов()

	Индекс = Новый Структура("Точные,ПоОснове,ФИО,Правила", Новый Соответствие,
		Новый Соответствие, Новый Массив, ПравилаКонтрольногоФайла());
	Запрос = Новый Запрос(
		"ВЫБРАТЬ К.Ссылка, К.Наименование, К.НаименованиеПолное, К.ИндивидуальныйПредприниматель
		|ИЗ Справочник.Контрагенты КАК К
		|ГДЕ НЕ К.ЭтоГруппа И НЕ К.ПометкаУдаления");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьВИндекс(Индекс, Выборка.Ссылка, Выборка.Наименование,
			Выборка.НаименованиеПолное, Выборка.ИндивидуальныйПредприниматель);
	КонецЦикла;
	Возврат Индекс;

КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьВИндекс(Индекс, Ссылка, Имя, ПолноеИмя, ЭтоИП)

	Для Каждого Вариант Из СтрРазделить(Имя + Символы.ПС + ПолноеИмя, Символы.ПС, Ложь) Цикл
		Если ПустаяСтрока(Вариант) Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьКандидата(Индекс.Точные, НормализоватьИмя(Вариант), Ссылка);
		// В справочнике могут быть уже созданы карточки с полным именем точки.
		Попытка
			Разбор = РазобратьКонтрагента(Вариант, Индекс.Правила);
		Исключение
			// Непригодный для нечеткого поиска вариант не останавливает весь
			// импорт. Точное совпадение с ним по-прежнему доступно.
			Продолжить;
		КонецПопытки;
		ИмяДляПоиска = Разбор.ДанныеИмени;
		Форма = ИмяДляПоиска.Форма;
		Если ЭтоИП Тогда
			Форма = "ИП";
		КонецЕсли;
		Значения = Индекс.ПоОснове.Получить(ИмяДляПоиска.Основа);
		Если Значения = Неопределено Тогда
			Значения = Новый Массив;
			Индекс.ПоОснове.Вставить(ИмяДляПоиска.Основа, Значения);
		КонецЕсли;
		Значения.Добавить(Новый Структура("Ссылка,Форма", Ссылка, Форма));
		Если Форма = "ИП" Тогда
			Индекс.ФИО.Добавить(Новый Структура("Ссылка,Слова", Ссылка, ИмяДляПоиска.Слова));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьКандидата(Индекс, Ключ, Ссылка)

	Кандидаты = Индекс.Получить(Ключ);
	Если Кандидаты = Неопределено Тогда
		Кандидаты = Новый Массив;
		Индекс.Вставить(Ключ, Кандидаты);
	КонецЕсли;
	Если Кандидаты.Найти(Ссылка) = Неопределено Тогда
		Кандидаты.Добавить(Ссылка);
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция НайтиКонтрагента(Данные, Индекс)

	Точные = Индекс.Точные.Получить(НормализоватьИмя(Данные.ИсходноеИмя));
	Если Точные <> Неопределено Тогда
		Возврат Точные;
	КонецЕсли;
	Имя = Данные.Разбор.ДанныеИмени;
	Кандидаты = Новый Массив;
	// Для ИП сразу проверяем все совместимые ФИО, а не выбираем короткую
	// карточку по фамилии прежде других полных ФИО с той же фамилией.
	Если Имя.Форма = "ИП" Тогда
		Для Каждого Запись Из Индекс.ФИО Цикл
			Если ФИОСовместимы(Имя.Слова, Запись.Слова)
				И НЕ ЕстьПротиворечиеФИО(Имя.Слова, Запись.Ссылка, Индекс.ФИО) Тогда
				Если Кандидаты.Найти(Запись.Ссылка) = Неопределено Тогда
					Кандидаты.Добавить(Запись.Ссылка);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	Иначе
		Записи = Индекс.ПоОснове.Получить(Имя.Основа);
		Если Записи <> Неопределено Тогда
			Для Каждого Запись Из Записи Цикл
				Если НЕ ПустаяСтрока(Имя.Форма) И НЕ ПустаяСтрока(Запись.Форма)
					И Имя.Форма <> Запись.Форма Тогда
					Продолжить;
				КонецЕсли;
				Если Кандидаты.Найти(Запись.Ссылка) = Неопределено Тогда
					Кандидаты.Добавить(Запись.Ссылка);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Возврат Кандидаты;

КонецФункции

&НаСервереБезКонтекста
Функция ЕстьПротиворечиеФИО(Слова, Ссылка, ЗаписиФИО)

	Для Каждого Запись Из ЗаписиФИО Цикл
		Если Запись.Ссылка <> Ссылка Или Запись.Слова.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		// Короткое "ИП Иванов" не должно перекрывать полное имя карточки
		// "Иванов Петр", когда в реестре указан "Иванов Иван".
		Если Запись.Слова[0] = Слова[0] И НЕ ФИОСовместимы(Слова, Запись.Слова) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

&НаСервереБезКонтекста
Функция ПредставитьСсылки(Ссылки)

	Представления = Новый Массив;
	Для Каждого Ссылка Из Ссылки Цикл
		Представления.Добавить(Строка(Ссылка) + " [" + Строка(Ссылка.УникальныйИдентификатор()) + "]");
	КонецЦикла;
	Возврат СтрСоединить(Представления, "; ");

КонецФункции

#КонецОбласти

#Область Отчет

&НаСервереБезКонтекста
Функция НовыйРезультатЗагрузки()

	Статистика = Новый Соответствие;
	Для Каждого Статус Из СтрРазделить("Проведено|Уже загружено|Пропущено|Ошибка", "|") Цикл
		Статистика.Вставить(Статус, Новый Структура("Количество,Сумма", 0, 0));
	КонецЦикла;
	Возврат Новый Структура("Статистика,Проблемы,Созданы,Примечания,ИмяФайла", Статистика,
		Новый Массив, Новый Соответствие, Новый Массив, "");

КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьИтог(Отчет, Статус, Сумма)

	Итог = Отчет.Статистика.Получить(Статус);
	Итог.Количество = Итог.Количество + 1;
	Итог.Сумма = Итог.Сумма + Сумма;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьПроблему(Отчет, Данные, Статус, Причина)

	ДобавитьИтог(Отчет, Статус, Данные.Сумма);
	Отчет.Проблемы.Добавить(Новый Структура("СтрокаExcel,Номер,Ордер,Имя,Сумма,Статус,Причина",
		Данные.СтрокаExcel, Данные.Номер, Данные.Ордер, Данные.ИсходноеИмя, Данные.Сумма, Статус, Причина));

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗарегистрироватьСозданного(Отчет, Объект, Данные)

	Созданный = Новый Структура("Ссылка,Код,Имя,Тип,ТипПоУмолчанию,Исходные",
		Объект.Ссылка, Объект.Код, Объект.Наименование,
		?(Объект.ИндивидуальныйПредприниматель, "ИП", "Юридическое лицо"),
		Данные.Разбор.ТипПоУмолчанию, Новый Соответствие);
	Отчет.Созданы.Вставить(Объект.Ссылка, Созданный);
	ДобавитьИсходноеСозданному(Отчет, Объект.Ссылка, Данные.ИсходноеИмя);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьИсходноеСозданному(Отчет, Ссылка, Исходное)

	Если Ссылка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Созданный = Отчет.Созданы.Получить(Ссылка);
	Если Созданный <> Неопределено Тогда
		Созданный.Исходные.Вставить(НормализоватьИмя(Исходное), Исходное);
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция СводкаЗагрузки(Отчет)

	Строки = Новый Массив;
	Для Каждого Статус Из СтрРазделить("Проведено|Уже загружено|Пропущено|Ошибка", "|") Цикл
		Итог = Отчет.Статистика.Получить(Статус);
		Строки.Добавить(Статус + ": " + Формат(Итог.Количество, "ЧГ=0")
			+ "; сумма " + Формат(Итог.Сумма, "ЧДЦ=2;ЧН=0,00") + " руб.");
	КонецЦикла;
	Строки.Добавить("Автоматически создано контрагентов: " + Строка(Отчет.Созданы.Количество()));
	Для Каждого Примечание Из Отчет.Примечания Цикл
		Строки.Добавить(Примечание);
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

&НаСервереБезКонтекста
Функция СформироватьОтчет(Отчет)

	ТабДок = Новый ТабличныйДокумент;
	СтрокаОтчета = 1;
	ВывестиЯчейку(ТабДок, СтрокаОтчета, 1, "Загрузка продаж iiko. " + Отчет.ИмяФайла);
	СтрокаОтчета = СтрокаОтчета + 1;
	Для Каждого Текст Из СтрРазделить(СводкаЗагрузки(Отчет), Символы.ПС) Цикл
		ВывестиЯчейку(ТабДок, СтрокаОтчета, 1, Текст);
		СтрокаОтчета = СтрокаОтчета + 1;
	КонецЦикла;
	СтрокаОтчета = СтрокаОтчета + 1;
	ВывестиЯчейку(ТабДок, СтрокаОтчета, 1, "НЕ НАЙДЕНЫ И АВТОМАТИЧЕСКИ СОЗДАНЫ КОНТРАГЕНТЫ");
	СтрокаОтчета = СтрокаОтчета + 1;
	ВывестиЗаголовки(ТабДок, СтрокаОтчета, "Исходные названия Excel|Очищенное имя|Код|Тип|Проверка типа|Ссылка на контрагента");
	Для Каждого Пара Из Отчет.Созданы Цикл
		СтрокаОтчета = СтрокаОтчета + 1;
		Созданный = Пара.Значение;
		Исходные = Новый Массив;
		Для Каждого Исходное Из Созданный.Исходные Цикл
			Исходные.Добавить(Исходное.Значение);
		КонецЦикла;
		ВывестиЯчейку(ТабДок, СтрокаОтчета, 1, СтрСоединить(Исходные, Символы.ПС));
		ВывестиЯчейку(ТабДок, СтрокаОтчета, 2, Созданный.Имя);
		ВывестиЯчейку(ТабДок, СтрокаОтчета, 3, Созданный.Код);
		ВывестиЯчейку(ТабДок, СтрокаОтчета, 4, Созданный.Тип);
		ВывестиЯчейку(ТабДок, СтрокаОтчета, 5,
			?(Созданный.ТипПоУмолчанию, "Тип выбран по умолчанию — проверить", "По обозначению ИП/ООО"));
		ВывестиЯчейку(ТабДок, СтрокаОтчета, 6, ПолучитьНавигационнуюСсылку(Созданный.Ссылка));
		ТабДок.Область(СтрокаОтчета, 2).Расшифровка = Созданный.Ссылка;
	КонецЦикла;
	СтрокаОтчета = СтрокаОтчета + 2;
	ВывестиЯчейку(ТабДок, СтрокаОтчета, 1, "ПРОПУЩЕННЫЕ СТРОКИ, КОНФЛИКТЫ И ОШИБКИ");
	СтрокаОтчета = СтрокаОтчета + 1;
	ВывестиЗаголовки(ТабДок, СтрокаОтчета, "Строка Excel|Номер iiko|Ордер|Исходный контрагент|Сумма|Статус|Причина");
	Для Каждого Проблема Из Отчет.Проблемы Цикл
		СтрокаОтчета = СтрокаОтчета + 1;
		ВывестиЯчейку(ТабДок, СтрокаОтчета, 1, Строка(Проблема.СтрокаExcel));
		ВывестиЯчейку(ТабДок, СтрокаОтчета, 2, Проблема.Номер);
		ВывестиЯчейку(ТабДок, СтрокаОтчета, 3, Проблема.Ордер);
		ВывестиЯчейку(ТабДок, СтрокаОтчета, 4, Проблема.Имя);
		ВывестиЯчейку(ТабДок, СтрокаОтчета, 5, Формат(Проблема.Сумма, "ЧДЦ=2;ЧН=0,00"));
		ВывестиЯчейку(ТабДок, СтрокаОтчета, 6, Проблема.Статус);
		ВывестиЯчейку(ТабДок, СтрокаОтчета, 7, Проблема.Причина);
	КонецЦикла;
	Возврат ТабДок;

КонецФункции

&НаСервереБезКонтекста
Процедура ВывестиЗаголовки(ТабДок, НомерСтроки, Заголовки)

	Колонка = 1;
	Для Каждого Заголовок Из СтрРазделить(Заголовки, "|") Цикл
		ВывестиЯчейку(ТабДок, НомерСтроки, Колонка, Заголовок);
		Колонка = Колонка + 1;
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВывестиЯчейку(ТабДок, НомерСтроки, Колонка, Текст)

	Область = ТабДок.Область(НомерСтроки, Колонка);
	Область.Текст = Текст;
	Область.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	Область.ШиринаКолонки = ?(Колонка = 1 Или Колонка >= 4, 45, 24);

КонецПроцедуры

#КонецОбласти
