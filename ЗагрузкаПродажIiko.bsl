Функция СоздатьРеализацию(Данные, Контекст, Контрагент, Договор)

	Документ = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
	Заполнение = Новый Структура("Дата,Организация,Контрагент,ДоговорКонтрагента,Склад,ВидОперации",
		Данные.Дата, Контекст.Организация, Контрагент, Договор, Контекст.Склад,
		Перечисления.ВидыОперацийРеализацияТоваров.Товары);
	Документ.Заполнить(Заполнение);
	Документ.Дата = Данные.Дата;
	Документ.Организация = Контекст.Организация;
	Документ.Склад = Контекст.Склад;
	Документ.Контрагент = Контрагент;
	Документ.ДоговорКонтрагента = Договор;
	Документ.ВидОперации = Перечисления.ВидыОперацийРеализацияТоваров.Товары;
	Документ.ВалютаДокумента = Контекст.Валюта;
	Документ.КурсВзаиморасчетов = 1;
	Документ.КратностьВзаиморасчетов = 1;
	Документ.СпособЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.Автоматически;
	Документ.ДокументБезНДС = Истина;
	Документ.СуммаВключаетНДС = Истина;
	СтрокаТовара = Документ.Товары.Добавить();
	СтрокаТовара.Номенклатура = Контекст.Товар;
	СтрокаТовара.ЕдиницаИзмерения = Контекст.Товар.ЕдиницаИзмерения;
	СтрокаТовара.Коэффициент = 1;
	СтрокаТовара.Количество = 1;
	СтрокаТовара.Цена = Данные.Сумма;
	СтрокаТовара.Сумма = Данные.Сумма;
	СтрокаТовара.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
	СтрокаТовара.СуммаНДС = 0;
	СтрокаТовара.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
	Документ.СуммаДокумента = Данные.Сумма;
	Документ.Комментарий = КомментарийРеализации(Данные, Документ);
	Документ.ДополнительныеСвойства.Вставить("ЗаполнитьСчетаУчетаПередЗаписью", Истина);
	СчетаУчетаВДокументах.Заполнить(Документ, Новый Структура("НеЗаполненныеРеквизиты", Истина));
	Если НЕ Документ.ПроверитьЗаполнение() Тогда
		ВызватьИсключение "Реализация не прошла проверку заполнения. Проверьте настройки счетов, склада и товара.";
	КонецЕсли;
	Возврат Документ;

КонецФункции

&НаСервереБезКонтекста
Функция КлючСтроки(Данные, Знач ИдентификаторОрганизации = "")

	// Организация входит в НЕИЗМЕНЯЕМЫЙ ключ, а не только в отбор по шапке.
	// Даже перенос документа на другую дату/организацию будет найден как конфликт.
	// Длины исключают коллизии даже для номеров с разделителями.
	Возврат "IIKO:v1|" + ИдентификаторОрганизации + "|" + Формат(Данные.Дата, "ДФ=yyyyMMdd") + "|"
		+ Формат(СтрДлина(Данные.Номер), "ЧГ=0") + ":" + Данные.Номер + "|"
		+ Формат(СтрДлина(Данные.Ордер), "ЧГ=0") + ":" + Данные.Ордер;

КонецФункции

&НаСервереБезКонтекста
Функция КомментарийРеализации(Данные, Документ)

	Комментарий = Данные.Ключ + Символы.ПС
		+ "Номер накладной iiko: " + Данные.Номер + Символы.ПС
		+ "Номер ордера iiko: " + Данные.Ордер + Символы.ПС
		+ "Исходное название iiko: " + Данные.ИсходноеИмя;
	Если НЕ ПустаяСтрока(Данные.Разбор.Адрес) Тогда
		Комментарий = Комментарий + Символы.ПС + "Адрес из iiko: " + Данные.Разбор.Адрес;
	КонецЕсли;
	Если НЕ ПустаяСтрока(Данные.Разбор.Точка) Тогда
		Комментарий = Комментарий + Символы.ПС + "Точка из iiko: " + Данные.Разбор.Точка;
	КонецЕсли;
	// Снимок ссылок позволяет обнаружить ручную замену контрагента/договора
	// даже тогда, когда новый договор формально тоже подходит.
	Возврат Комментарий + Символы.ПС + "Ссылки iiko: "
		+ Строка(Документ.Организация.УникальныйИдентификатор()) + ";"
		+ Строка(Документ.Склад.УникальныйИдентификатор()) + ";"
		+ Строка(Документ.Контрагент.УникальныйИдентификатор()) + ";"
		+ Строка(Документ.ДоговорКонтрагента.УникальныйИдентификатор()) + ";"
		+ Строка(Документ.Товары[0].Номенклатура.УникальныйИдентификатор());

