&НаСервереБезКонтекста
Функция СжатьПробелы(Знач Текст)

	Текст = СтрЗаменить(Строка(Текст), Символ(160), " ");
	Текст = СтрЗаменить(Текст, Символ(8239), " ");
	Текст = СтрЗаменить(Текст, Символы.Таб, " ");
	Текст = СтрЗаменить(Текст, Символы.ПС, " ");
	Текст = СтрЗаменить(Текст, Символы.ВК, " ");
	Пока СтрНайти(Текст, "  ") > 0 Цикл
		Текст = СтрЗаменить(Текст, "  ", " ");
	КонецЦикла;
	Возврат СокрЛП(Текст);

КонецФункции

&НаСервереБезКонтекста
Функция НормализоватьИмя(Знач Текст)

	Текст = СтрЗаменить(ВРег(СжатьПробелы(Текст)), "Ё", "Е");
	Для Каждого Кавычка Из СтрРазделить("«|»|“|”|„|""|'", "|") Цикл
		Текст = СтрЗаменить(Текст, Кавычка, " ");
	КонецЦикла;
	Возврат СжатьПробелы(Текст);

КонецФункции

&НаСервереБезКонтекста
Функция СловаИмени(Знач Текст, СохранятьДефис = Ложь)

	Текст = НормализоватьИмя(Текст);
	Текст = СтрЗаменить(Текст, Символ(8208), "-");
	Текст = СтрЗаменить(Текст, Символ(8209), "-");
	Для Каждого Разделитель Из СтрРазделить(".|,|;|:|(|)|[|]|{|}|/|\|-|–|—|!|?", "|") Цикл
		Если СохранятьДефис И Разделитель = "-" Тогда
			Продолжить;
		КонецЕсли;
		Текст = СтрЗаменить(Текст, Разделитель, " ");
	КонецЦикла;
	Текст = СтрЗаменить(Текст, "ИНДИВИДУАЛЬНЫЙ ПРЕДПРИНИМАТЕЛЬ", "ИП");
	Текст = СтрЗаменить(Текст, "ОБЩЕСТВО С ОГРАНИЧЕННОЙ ОТВЕТСТВЕННОСТЬЮ", "ООО");
	Возврат СтрРазделить(СжатьПробелы(Текст), " ", Ложь);

