// БП 3.0.195.40. МОДУЛЬ ОБЪЕКТА ВНЕШНЕЙ ОБРАБОТКИ. Версия 1.3.4.
// В конфигураторе открыть EPF, у корневого узла обработки открыть модуль
// объекта и вставить сюда весь этот файл. Основной формой назначить форму,
// в модуль которой вставлен файл ЗагрузкаПродажIiko.bsl.
// Функция регистрирует обработку в Дополнительных отчетах и обработках БП.
// При обновлении синхронизировать версию с ВерсияОбработкиIiko() модуля формы.
// Номер версии выводится через Сообщить при открытии основной формы.
// Безопасный режим отключен для штатных механизмов БП, использующих
// привилегированный доступ к общим настройкам сопоставлений.

Функция СведенияОВнешнейОбработке() Экспорт

	Сведения = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке(
		СтандартныеПодсистемыСервер.ВерсияБиблиотеки());
	Сведения.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	Сведения.Наименование = "Загрузка продаж iiko";
	Сведения.Версия = "1.3.4";
	Сведения.БезопасныйРежим = Ложь;
	Сведения.Информация = "Загрузка реестра iiko из XLSX в реализации без НДС с одной товарной строкой.";

	Команда = Сведения.Команды.Добавить();
	Команда.Представление = "Загрузка продаж iiko";
	Команда.Идентификатор = "ОткрытьФорму";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	Команда.ПоказыватьОповещение = Ложь;

	Возврат Сведения;

КонецФункции
