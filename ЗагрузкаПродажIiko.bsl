&НаСервереБезКонтекста
Функция ПрочитатьЗагруженныеДокументы(Строки, Контекст)

	ИдентификаторОрганизации = Строка(Контекст.Организация.УникальныйИдентификатор());
	Для Каждого Данные Из Строки Цикл
		Данные.Ключ = КлючСтроки(Данные, ИдентификаторОрганизации);
	КонецЦикла;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Р.Ссылка, Р.Комментарий
		|ИЗ Документ.РеализацияТоваровУслуг КАК Р
		|ГДЕ Р.Комментарий ПОДОБНО &Метка");
	Запрос.УстановитьПараметр("Метка", "IIKO:v1|" + ИдентификаторОрганизации + "|%");
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = СокрЛП(СтрРазделить(Выборка.Комментарий, Символы.ПС)[0]);
		ДобавитьКандидата(Результат, Ключ, Выборка.Ссылка);
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьПовтор(Документ, Данные, Контекст, Контрагент)

	Если Документ.ПометкаУдаления Тогда
		Возврат "Документ помечен на удаление.";
	ИначеЕсли НЕ Документ.Проведен Тогда
		Возврат "Документ не проведен.";
	ИначеЕсли Контрагент = Неопределено Тогда
		Возврат "Контрагент исходной строки больше не найден в справочнике.";
	ИначеЕсли Документ.Контрагент <> Контрагент Тогда
		Возврат "Изменен контрагент или его сопоставление.";
	ИначеЕсли Документ.Дата <> Данные.Дата Или Документ.Организация <> Контекст.Организация
		Или Документ.Склад <> Контекст.Склад Тогда
		Возврат "Отличаются дата, организация или склад.";
	ИначеЕсли Документ.ВидОперации <> Перечисления.ВидыОперацийРеализацияТоваров.Товары Тогда
		Возврат "Изменен вид операции.";
	ИначеЕсли Документ.Товары.Количество() <> 1 Или Документ.Услуги.Количество() <> 0
		Или Документ.ВозвратнаяТара.Количество() <> 0 Или Документ.АгентскиеУслуги.Количество() <> 0 Тогда
		Возврат "Изменен состав табличных частей.";
	КонецЕсли;
	Товар = Документ.Товары[0];
	Если Товар.Номенклатура <> Контекст.Товар Или Товар.Количество <> 1 Или Товар.Коэффициент <> 1
		Или Товар.ЕдиницаИзмерения <> Контекст.Товар.ЕдиницаИзмерения Тогда
		Возврат "Изменены товар, единица измерения или количество.";
	ИначеЕсли Товар.Цена <> Данные.Сумма Или Товар.Сумма <> Данные.Сумма
		Или Документ.СуммаДокумента <> Данные.Сумма Тогда
		Возврат "Сумма отличается от Excel.";
	ИначеЕсли Товар.СтавкаНДС <> Перечисления.СтавкиНДС.БезНДС Или Товар.СуммаНДС <> 0
		Или НЕ Документ.ДокументБезНДС Или НЕ Документ.СуммаВключаетНДС Тогда
		Возврат "Отличаются настройки НДС.";
	ИначеЕсли Документ.ВалютаДокумента <> Контекст.Валюта
		Или Документ.КурсВзаиморасчетов <> 1 Или Документ.КратностьВзаиморасчетов <> 1 Тогда
		Возврат "Изменены валюта или курс.";
	КонецЕсли;
	Договор = Документ.ДоговорКонтрагента;
	Если НЕ ЗначениеЗаполнено(Договор) Тогда
		Возврат "Не заполнен договор.";
	КонецЕсли;
	Если Договор.ПометкаУдаления Или Договор.ДоговорЗакрыт Или Договор.Владелец <> Контрагент
		Или Договор.Организация <> Контекст.ОрганизацияДоговора
		Или Договор.ВидДоговора <> Перечисления.ВидыДоговоровКонтрагентов.СПокупателем
		Или Договор.ВалютаВзаиморасчетов <> Контекст.Валюта Или Договор.РасчетыВУсловныхЕдиницах Тогда
		Возврат "Договор больше не подходит для загрузки.";
	КонецЕсли;
	Если Документ.Комментарий <> КомментарийРеализации(Данные, Документ) Тогда
		Возврат "Изменены исходные данные, адрес, комментарий или сохраненные ссылки.";
	КонецЕсли;
	Возврат "";

