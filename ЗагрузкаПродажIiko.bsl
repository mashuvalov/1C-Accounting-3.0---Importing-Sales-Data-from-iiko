&НаСервереБезКонтекста
Функция ДанныеИмени(Знач Наименование)

	// Составная фамилия — один токен: Иванов и Иванов-Петров не совпадают.
	Слова = СловаИмени(Наименование, Истина);
	Форма = "";
	БезФормы = Новый Массив;
	Для Каждого Слово Из Слова Цикл
		Если Слово = "ИП" Или Слово = "ООО" Тогда
			Если НЕ ПустаяСтрока(Форма) И Форма <> Слово Тогда
				ВызватьИсключение "В названии одновременно указаны ИП и ООО: " + Наименование;
			КонецЕсли;
			Форма = Слово;
		Иначе
			БезФормы.Добавить(Слово);
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("Форма,Слова,Основа", Форма, БезФормы, СтрСоединить(БезФормы, " "));

КонецФункции

&НаСервереБезКонтекста
Функция ПравилаКонтрольногоФайла()

	Правила = Новый Соответствие;
	// Исходное имя | очищенное имя | адрес | обозначение точки/бренда.
	// Телефоны остаются в исходном имени, но не попадают в извлеченный адрес.
	ДобавитьПравило(Правила, "Строкова ИП Автозаводская, 7, к 6", "ИП Строкова", "Автозаводская, 7, к 6");
