// БП 3.0.195.40, платформа 8.3.27+. МОДУЛЬ УПРАВЛЯЕМОЙ ФОРМЫ.
// При каждом обновлении модуля увеличивать ВерсияОбработкиIiko().
// Номер версии выводится через Сообщить при создании формы.
// Сборка: создать внешнюю обработку, добавить основную управляемую форму,
// вставить сюда весь этот файл. В свойствах формы назначить обработчик события
// ПриСозданииНаСервере — ПриСозданииНаСервере из этого модуля.
// Поля файла, организации и склада, команда и кнопка ВЫПОЛНИТЬ создаются кодом.
// Реквизиты формы, макеты и модуль объекта вручную добавлять не требуется.
// При открытии выбрать организацию и склад из справочников и файл на компьютере
// клиента 1С Windows. Путь по умолчанию C:\iiko.xlsx; справа у поля — выбор XLSX.
// Настройки в коде заполнять не требуется. Передача файла на сервер штатная.
// Открывать обработку пользователем с правами записи справочников и проведения
// реализаций. Организация, счета товара и допустимость продажи без остатков
// должны быть настроены в базе. ОбменДанными.Загрузка не используется.
// Каждая строка — отдельная реализация, НЕ банковская оплата и НЕ расчет УСН.
// Номер 1С автоматический; номер iiko, ордер, исходное имя и адрес — в комментарии.
// Служебные строки IIKO:v1 и Ссылки iiko в комментариях НЕ удалять и НЕ менять:
// они обеспечивают проверку повторной загрузки. Исправления конфликтов — вручную.
// После сборки проверить на копии базы: отсутствие/неоднозначность товара;
// новый контрагент без ИНН; разные точки одного контрагента и адреса в документах;
// разные ордера одного номера; повтор файла без дублей; изменение суммы;
// удаленный/непроведенный импортированный документ; ошибка проведения с откатом.
// Проверить неоднозначность ФИО, различие простой и составной фамилии,
// несколько договоров Продажи iiko (в том числе при наличии основного).
// При отключенном учете по договорам БП может заменить договор перед записью:
// несовпадение с выбранным договором откатывается и выводится как ошибка строки.
// Разработка и статические проверки выполняются без запуска 1С.

&НаКлиенте
Перем ЗагрузкаВыполняется;

#Область Версия

&НаСервереБезКонтекста
Функция ВерсияОбработкиIiko()

	Возврат "1.1.0";

КонецФункции

#КонецОбласти

#Область СозданиеФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Сообщить("Загрузка продаж iiko. Версия " + ВерсияОбработкиIiko());
	Реквизиты = Новый Массив;
	Реквизиты.Добавить(Новый РеквизитФормы("ПутьФайлаIiko", Новый ОписаниеТипов("Строка"),, "Файл реестра"));
	Реквизиты.Добавить(Новый РеквизитФормы("ОрганизацияIiko",
		Новый ОписаниеТипов("СправочникСсылка.Организации"),, "Организация"));
	Реквизиты.Добавить(Новый РеквизитФормы("СкладIiko",
		Новый ОписаниеТипов("СправочникСсылка.Склады"),, "Склад"));
	ИзменитьРеквизиты(Реквизиты);
	ЭтотОбъект["ПутьФайлаIiko"] = "C:\iiko.xlsx";

	Группа = Элементы.Добавить("НастройкиIiko", Тип("ГруппаФормы"));
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	Группа.ОтображатьЗаголовок = Ложь;
	ПолеФайла = ДобавитьПолеНастройкиIiko("ПутьФайлаIiko", "Файл реестра", Группа);
	ПолеФайла.КнопкаВыбора = Истина;
	ПолеФайла.УстановитьДействие("НачалоВыбора", "ПутьФайлаIikoНачалоВыбора");
	ДобавитьПолеНастройкиIiko("ОрганизацияIiko", "Организация", Группа);
	ДобавитьПолеНастройкиIiko("СкладIiko", "Склад", Группа);

	// Поддерживается и прежняя сборка, где команда/кнопка были созданы вручную.
	КомандаЗагрузки = Команды.Найти("Выполнить");
	Если КомандаЗагрузки = Неопределено Тогда
		КомандаЗагрузки = Команды.Добавить("Выполнить");
	КонецЕсли;
	КомандаЗагрузки.Действие = "ВыполнитьЗагрузку";
	КомандаЗагрузки.Заголовок = "ВЫПОЛНИТЬ";
	Кнопка = Элементы.Найти("Выполнить");
	Если Кнопка = Неопределено Тогда
		Кнопка = Элементы.Добавить("Выполнить", Тип("КнопкаФормы"));
	КонецЕсли;
	Кнопка.ИмяКоманды = "Выполнить";

КонецПроцедуры

&НаСервере
Функция ДобавитьПолеНастройкиIiko(ИмяРеквизита, Заголовок, Родитель)

	Поле = Элементы.Добавить(ИмяРеквизита, Тип("ПолеФормы"), Родитель);
	Поле.Вид = ВидПоляФормы.ПолеВвода;
	Поле.ПутьКДанным = ИмяРеквизита;
	Поле.Заголовок = Заголовок;
	Возврат Поле;

КонецФункции

&НаКлиенте
Процедура ПутьФайлаIikoНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Если ЗагрузкаВыполняется = Истина Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
		Диалог.Заголовок = "Выберите реестр накладных iiko";
		Диалог.Фильтр = "Реестр Excel (*.xlsx)|*.xlsx";
		Диалог.МножественныйВыбор = Ложь;
		Диалог.ПолноеИмяФайла = ЭтотОбъект["ПутьФайлаIiko"];
		Диалог.Показать(Новый ОписаниеОповещения("ПослеВыбораФайлаIiko", ЭтотОбъект));
	Исключение
		Сообщить("Не удалось открыть выбор файла: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораФайлаIiko(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	Если ЗагрузкаВыполняется = Истина Или ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ВыбранныеФайлы.Количество() > 0 Тогда
		ЭтотОбъект["ПутьФайлаIiko"] = ВыбранныеФайлы[0];
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область КомандаФормы

&НаКлиенте
Процедура ВыполнитьЗагрузку(Команда)

	Если ЗагрузкаВыполняется = Истина Тогда
		Возврат;
	КонецЕсли;
	УстановитьСостояниеЗагрузки(Истина);
	Попытка
		// Снимок параметров на момент нажатия; все последующие вызовы используют его.
		Настройки = Новый Структура("Организация,Склад,ПутьФайла",
			ЭтотОбъект["ОрганизацияIiko"], ЭтотОбъект["СкладIiko"], СокрЛП(ЭтотОбъект["ПутьФайлаIiko"]));
		Если ПустаяСтрока(Настройки.ПутьФайла) Тогда
			ВызватьИсключение "Выберите файл реестра.";
		КонецЕсли;
		Если ВРег(Прав(Настройки.ПутьФайла, 5)) <> ".XLSX" Тогда
			ВызватьИсключение "Требуется файл Excel с расширением .xlsx.";
		КонецЕсли;
		// Проверяем базу до передачи файла и, главное, до первой записи.
		ПроверитьНастройкиНаСервере(Настройки);
		Оповещение = Новый ОписаниеОповещения("ПослеПомещенияФайлаIiko", ЭтотОбъект, Настройки,
			"ОшибкаПомещенияФайлаIiko", ЭтотОбъект);
		// Параметр 4 — адрес временного хранилища, параметр 5 — путь на клиенте.
		НачатьПомещениеФайлаНаСервер(Оповещение,,,, Настройки.ПутьФайла, УникальныйИдентификатор);
	Исключение
		УстановитьСостояниеЗагрузки(Ложь);
		Сообщить("Загрузка iiko не начата: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПослеПомещенияФайлаIiko(ОписаниеПомещения, ДополнительныеПараметры) Экспорт

	Попытка
		Если ОписаниеПомещения = Неопределено Тогда
			ВызватьИсключение "Не удалось передать файл на сервер: " + ДополнительныеПараметры.ПутьФайла
				+ ". Проверьте наличие и доступность файла.";
		КонецЕсли;
		Если ОписаниеПомещения.ПомещениеФайлаОтменено Тогда
			ВызватьИсключение "Передача файла отменена.";
		КонецЕсли;
		Результат = ЗагрузитьНаСервере(ОписаниеПомещения.Адрес, ДополнительныеПараметры);
		Сообщить(Результат.Сводка);
		Результат.Отчет.Показать("Загрузка продаж iiko — результат");
	Исключение
		Сообщить("Загрузка iiko: " + ОписаниеОшибки());
	КонецПопытки;
	УстановитьСостояниеЗагрузки(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ОшибкаПомещенияФайлаIiko(ИнформацияОбОшибке, СтандартнаяОбработка, ДополнительныеПараметры) Экспорт

	СтандартнаяОбработка = Ложь;
	УстановитьСостояниеЗагрузки(Ложь);
	Сообщить("Не удалось передать файл " + ДополнительныеПараметры.ПутьФайла
		+ ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке));

КонецПроцедуры

&НаКлиенте
Процедура УстановитьСостояниеЗагрузки(Выполняется)

	ЗагрузкаВыполняется = Выполняется;
	Группа = Элементы.Найти("НастройкиIiko");
	Если Группа <> Неопределено Тогда
		Группа.Доступность = НЕ Выполняется;
	КонецЕсли;
	Кнопка = Элементы.Найти("Выполнить");
	Если Кнопка <> Неопределено Тогда
		Кнопка.Доступность = НЕ Выполняется;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ЧтениеИПроверка

&НаСервереБезКонтекста
Процедура ПроверитьНастройкиНаСервере(Настройки)

	ПолучитьКонтекстЗагрузки(Настройки);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКонтекстЗагрузки(Настройки)

	Организация = Настройки.Организация;
	Склад = Настройки.Склад;
	Если ТипЗнч(Организация) <> Тип("СправочникСсылка.Организации")
		Или НЕ ЗначениеЗаполнено(Организация) Тогда
		ВызватьИсключение "Выберите организацию на форме.";
	КонецЕсли;
	Если Организация.ПометкаУдаления Тогда
		ВызватьИсключение "Организация помечена на удаление.";
	КонецЕсли;
	Если ТипЗнч(Склад) <> Тип("СправочникСсылка.Склады")
		Или НЕ ЗначениеЗаполнено(Склад) Тогда
		ВызватьИсключение "Выберите склад на форме.";
	КонецЕсли;
	Если Склад.ПометкаУдаления Или Склад.ЭтоГруппа Тогда
		ВызватьИсключение "Выбранный склад является группой или помечен на удаление.";
	КонецЕсли;
	Товар = НайтиТовар();
	Если НЕ ЗначениеЗаполнено(Товар.ЕдиницаИзмерения) Тогда
		ВызватьИсключение "У товара не заполнена единица измерения: " + Строка(Товар);
	КонецЕсли;
	Валюта = ОбщегоНазначенияБПВызовСервераПовтИсп.ПолучитьВалютуРегламентированногоУчета();
	Если НЕ ЗначениеЗаполнено(Валюта) Тогда
		ВызватьИсключение "В базе не заполнена валюта регламентированного учета.";
	КонецЕсли;
	// Код классификатора валют: 643 (RUB), исторический код в некоторых базах 810.
	Если СокрЛП(Валюта.Код) <> "643" И СокрЛП(Валюта.Код) <> "810" Тогда
		ВызватьИсключение "Для этой загрузки валюта регламентированного учета должна быть рублем (643 или 810).";
	КонецЕсли;
	Контекст = Новый Структура("Организация,Склад,Товар,Валюта", Организация, Склад, Товар, Валюта);
	Контекст.Вставить("ОрганизацияДоговора",
		ОбщегоНазначенияБПВызовСервераПовтИсп.ГоловнаяОрганизация(Организация));
	Возврат Контекст;

КонецФункции

&НаСервереБезКонтекста
Функция НайтиТовар()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ Н.Ссылка, Н.Наименование
		|ИЗ Справочник.Номенклатура КАК Н
		|ГДЕ НЕ Н.ЭтоГруппа И НЕ Н.ПометкаУдаления И НЕ Н.Услуга");
	Точные = Новый Массив;
	СоСловом = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Имя = НормализоватьИмя(Выборка.Наименование);
		Если Имя = "ТОВАР" Тогда
			Точные.Добавить(Выборка.Ссылка);
		ИначеЕсли СловаИмени(Имя).Найти("ТОВАР") <> Неопределено Тогда
			СоСловом.Добавить(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Кандидаты = ?(Точные.Количество() > 0, Точные, СоСловом);
	Если Кандидаты.Количество() <> 1 Тогда
		ВызватьИсключение "Нужен один товар с названием или отдельным словом «Товар». Найдено: "
			+ Строка(Кандидаты.Количество()) + ". " + ПредставитьСсылки(Кандидаты);
	КонецЕсли;
	Возврат Кандидаты[0];

КонецФункции

&НаСервереБезКонтекста
Функция ПрочитатьПервыйЛист(ИмяФайла)

	// Имя ПЕРВОГО листа берем из manifest XLSX, а не из порядка именованных областей:
	// в Excel могут быть дополнительные именованные диапазоны и скрытые листы.
	ИмяЛиста = ИмяПервогоЛистаXlsx(ИмяФайла);
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.Прочитать(ИмяФайла, СпособЧтенияЗначенийТабличногоДокумента.Значение);
	Область = ТабДок.Области.Найти(ИмяЛиста);
	Если Область = Неопределено Тогда
		ВызватьИсключение "Не найдена область первого листа Excel: " + ИмяЛиста;
	КонецЕсли;
	ТабДок = ТабДок.ПолучитьОбласть(Область.Верх, Область.Лево, Область.Низ, Область.Право);
	ТабДок.Область().Разъединить();
	Возврат ТабДок;

КонецФункции

&НаСервереБезКонтекста
Функция ИмяПервогоЛистаXlsx(ИмяФайла)

	Каталог = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(Каталог);
	Архив = Неопределено;
	Чтение = Неопределено;
	ИмяXml = Каталог + "/workbook.xml";
	Попытка
		Архив = Новый ЧтениеZipФайла(ИмяФайла);
		Элемент = Неопределено;
		Для Каждого ЭлементАрхива Из Архив.Элементы Цикл
			Если СтрЗаменить(ЭлементАрхива.ПолноеИмя, "\", "/") = "xl/workbook.xml" Тогда
				Элемент = ЭлементАрхива;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Элемент = Неопределено Тогда
			ВызватьИсключение "В файле отсутствует xl/workbook.xml. Требуется корректный XLSX.";
		КонецЕсли;
		// Извлекается только известный файл, без путей из недоверенного архива.
		Архив.Извлечь(Элемент, Каталог, РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
		Архив.Закрыть();
		Архив = Неопределено;
		Чтение = Новый ЧтениеXML;
		Чтение.ОткрытьФайл(ИмяXml);
		ИмяЛиста = "";
		Пока Чтение.Прочитать() Цикл
			Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента И Чтение.ЛокальноеИмя = "sheet" Тогда
				ИмяЛиста = Чтение.ПолучитьАтрибут("name");
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Чтение.Закрыть();
		Чтение = Неопределено;
		Если ПустаяСтрока(ИмяЛиста) Тогда
			ВызватьИсключение "В XLSX не найден первый лист.";
		КонецЕсли;
	Исключение
		Если Чтение <> Неопределено Тогда
			Чтение.Закрыть();
		КонецЕсли;
		Если Архив <> Неопределено Тогда
			Архив.Закрыть();
		КонецЕсли;
		УдалитьВременныйФайл(ИмяXml);
		УдалитьВременныйФайл(Каталог);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьВременныйФайл(ИмяXml);
	УдалитьВременныйФайл(Каталог);
	Возврат ИмяЛиста;

КонецФункции

&НаСервереБезКонтекста
Процедура УдалитьВременныйФайл(ИмяФайла)

	Попытка
		Файл = Новый Файл(ИмяФайла);
		Если Файл.Существует() Тогда
			УдалитьФайлы(ИмяФайла);
		КонецЕсли;
	Исключение
		// Только временные файлы, созданные текущим вызовом; ошибка удаления
		// не должна скрывать результат уже проведенных документов.
		ЗаписьЖурналаРегистрации("ЗагрузкаIiko.ВременныйФайл", УровеньЖурналаРегистрации.Предупреждение,
			,, ИмяФайла + ": " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаСервереБезКонтекста
Функция НайтиЗаголовок(ТабДок)

	Ожидаемые = СтрРазделить("УЧЕТНАЯ ДАТА|НОМЕР|НОМЕР ОРДЕРА|КОРР.-КОНТРАГЕНТ|ДЕБЕТ", "|");
	Для НомерСтроки = 1 По ТабДок.ВысотаТаблицы Цикл
		Колонки = Новый Соответствие;
		Для Колонка = 1 По ТабДок.ШиринаТаблицы Цикл
			Заголовок = НормализоватьИмя(ТабДок.Область(НомерСтроки, Колонка).Текст);
			Если Ожидаемые.Найти(Заголовок) <> Неопределено Тогда
				Если Колонки.Получить(Заголовок) <> Неопределено Тогда
					ВызватьИсключение "Повторяется колонка " + Заголовок + " в строке " + Строка(НомерСтроки);
				КонецЕсли;
				Колонки.Вставить(Заголовок, Колонка);
			КонецЕсли;
		КонецЦикла;
		Если Колонки.Количество() = Ожидаемые.Количество() Тогда
			Возврат Новый Структура("НомерСтроки,Колонки", НомерСтроки, Колонки);
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Не найдены пять колонок реестра: Учетная дата, Номер, Номер ордера, Корр.-контрагент, Дебет.";

КонецФункции

&НаСервереБезКонтекста
Функция ЯчейкаРеестра(ТабДок, Заголовок, НомерСтроки, ИмяКолонки)

	Возврат ТабДок.Область(НомерСтроки, Заголовок.Колонки.Получить(ИмяКолонки));

КонецФункции

&НаСервереБезКонтекста
Функция ПрочитатьСтроки(ТабДок, Отчет)

	Заголовок = НайтиЗаголовок(ТабДок);
	Строки = Новый Массив;
	Правила = ПравилаКонтрольногоФайла();
	Для НомерСтроки = Заголовок.НомерСтроки + 1 По ТабДок.ВысотаТаблицы Цикл
		Номер = ТекстНомера(ЯчейкаРеестра(ТабДок, Заголовок, НомерСтроки, "НОМЕР"));
		Ордер = ТекстНомера(ЯчейкаРеестра(ТабДок, Заголовок, НомерСтроки, "НОМЕР ОРДЕРА"));
		ИсходноеИмя = СокрЛП(ЯчейкаРеестра(ТабДок, Заголовок, НомерСтроки, "КОРР.-КОНТРАГЕНТ").Текст);
		ЯчейкаДаты = ЯчейкаРеестра(ТабДок, Заголовок, НомерСтроки, "УЧЕТНАЯ ДАТА");
		ЯчейкаСуммы = ЯчейкаРеестра(ТабДок, Заголовок, НомерСтроки, "ДЕБЕТ");
		Если ПустаяСтрока(Номер) И ПустаяСтрока(Ордер) И ПустаяСтрока(ИсходноеИмя) Тогда
			// Строка-разделитель с одной датой, пустая строка либо итог без номера.
			// Сумма без номера допускается только у последней непустой строки.
			Если ПустаяСтрока(СокрЛП(ЯчейкаСуммы.Текст))
				Или ЭтоИтогРеестра(ТабДок, Заголовок, НомерСтроки) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Данные = Новый Структура("СтрокаExcel,Номер,Ордер,ИсходноеИмя,Дата,Сумма",
			НомерСтроки, Номер, Ордер, ИсходноеИмя, Неопределено, 0);
		Попытка
			Данные.Сумма = ПрочитатьСумму(ЗначениеЯчейки(ЯчейкаСуммы), ЯчейкаСуммы.Текст);
			Данные.Дата = ПрочитатьДату(ЗначениеЯчейки(ЯчейкаДаты), ЯчейкаДаты.Текст);
			Если ПустаяСтрока(Номер) Или ПустаяСтрока(Ордер) Или ПустаяСтрока(ИсходноеИмя) Тогда
				ВызватьИсключение "Не заполнены номер, ордер или контрагент.";
			КонецЕсли;
			Данные.Вставить("Разбор", РазобратьКонтрагента(ИсходноеИмя, Правила));
			Данные.Вставить("Ключ", КлючСтроки(Данные));
			Строки.Добавить(Данные);
		Исключение
			ДобавитьПроблему(Отчет, Данные, "Пропущено", ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
	Возврат Строки;

КонецФункции

&НаСервереБезКонтекста
Функция ЭтоИтогРеестра(ТабДок, Заголовок, НомерСтроки)

	Для СтрокаНиже = НомерСтроки + 1 По ТабДок.ВысотаТаблицы Цикл
		Для Каждого Колонка Из Заголовок.Колонки Цикл
			Если НЕ ПустаяСтрока(СокрЛП(ТабДок.Область(СтрокаНиже, Колонка.Значение).Текст)) Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	// У контрольного файла итог — последняя строка, дата + сумма, без текста Итого.
	ТекстДаты = НормализоватьИмя(ЯчейкаРеестра(ТабДок, Заголовок, НомерСтроки, "УЧЕТНАЯ ДАТА").Текст);
	Если СтрНайти(ТекстДаты, "ИТОГО") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Попытка
		Ячейка = ЯчейкаРеестра(ТабДок, Заголовок, НомерСтроки, "УЧЕТНАЯ ДАТА");
		ПрочитатьДату(ЗначениеЯчейки(Ячейка), Ячейка.Текст);
		Ячейка = ЯчейкаРеестра(ТабДок, Заголовок, НомерСтроки, "ДЕБЕТ");
		Итог = ПрочитатьСумму(ЗначениеЯчейки(Ячейка), Ячейка.Текст);
		СуммаСтрок = 0;
		Для СтрокаВыше = Заголовок.НомерСтроки + 1 По НомерСтроки - 1 Цикл
			ЕстьДанные = Ложь;
			Для Каждого ИмяКолонки Из СтрРазделить("НОМЕР|НОМЕР ОРДЕРА|КОРР.-КОНТРАГЕНТ", "|") Цикл
				Если НЕ ПустаяСтрока(СокрЛП(ЯчейкаРеестра(ТабДок, Заголовок, СтрокаВыше, ИмяКолонки).Текст)) Тогда
					ЕстьДанные = Истина;
				КонецЕсли;
			КонецЦикла;
			Если ЕстьДанные Тогда
				Ячейка = ЯчейкаРеестра(ТабДок, Заголовок, СтрокаВыше, "ДЕБЕТ");
				СуммаСтрок = СуммаСтрок + ПрочитатьСумму(ЗначениеЯчейки(Ячейка), Ячейка.Текст);
			КонецЕсли;
		КонецЦикла;
		// Последняя строка с датой и суммой — итог лишь при совпадении
		// с суммой данных. Иначе это неполная строка, которую нужно показать.
		Возврат Итог = СуммаСтрок;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

&НаСервереБезКонтекста
Функция ЗначениеЯчейки(Ячейка)

	// У текстовых и пустых ячеек обращение к .Значение вызывает исключение.
	Если Ячейка.СодержитЗначение Тогда
		Возврат Ячейка.Значение;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

&НаСервереБезКонтекста
Функция ТекстНомера(Ячейка)

	// Текст сохраняет и строковые "0868", и числовую ячейку с форматом 0000.
	Текст = СокрЛП(СтрЗаменить(Ячейка.Текст, Символ(160), " "));
	Если ТипЗнч(ЗначениеЯчейки(Ячейка)) = Тип("Число") Тогда
		Текст = СтрЗаменить(Текст, " ", "");
	КонецЕсли;
	Возврат Текст;

КонецФункции

&НаСервереБезКонтекста
Функция ПрочитатьСумму(Знач ЗначениеЯчейки, Знач Текст)

	Если ТипЗнч(ЗначениеЯчейки) = Тип("Число") Тогда
		Сумма = ЗначениеЯчейки;
	Иначе
		Текст = СтрЗаменить(СокрЛП(Текст), Символ(160), "");
		Текст = СтрЗаменить(Текст, " ", "");
		Текст = СтрЗаменить(Текст, Символ(8239), "");
		Текст = СтрЗаменить(Текст, ",", ".");
		Если ПустаяСтрока(Текст) Тогда
			ВызватьИсключение "Не заполнена сумма.";
		КонецЕсли;
		Для Индекс = 1 По СтрДлина(Текст) Цикл
			Если СтрНайти("0123456789.-+", Сред(Текст, Индекс, 1)) = 0 Тогда
				ВызватьИсключение "Некорректная сумма: " + Текст;
			КонецЕсли;
		КонецЦикла;
		Сумма = Число(Текст);
	КонецЕсли;
	Сумма = Окр(Сумма, 2);
	Если Сумма <= 0 Тогда
		ВызватьИсключение "Сумма должна быть больше нуля.";
	КонецЕсли;
	Возврат Сумма;

КонецФункции

&НаСервереБезКонтекста
Функция ПрочитатьДату(Знач ЗначениеЯчейки, Знач Текст)

	Если ТипЗнч(ЗначениеЯчейки) = Тип("Дата") Тогда
		Результат = НачалоДня(ЗначениеЯчейки);
	ИначеЕсли ТипЗнч(ЗначениеЯчейки) = Тип("Число") Тогда
		// Резерв для обычной системы дат Excel 1900; нативное чтение XLSX
		// уже преобразует даты с форматом даты, в том числе систему Excel 1904.
		Если ЗначениеЯчейки < 61 Или ЗначениеЯчейки > 2958465 Тогда
			ВызватьИсключение "Некорректная числовая дата Excel.";
		КонецЕсли;
		Результат = НачалоДня(Дата(1899, 12, 30) + Цел(ЗначениеЯчейки) * 86400);
	Иначе
		Текст = СокрЛП(Текст);
		Если СтрДлина(Текст) < 10 Тогда
			ВызватьИсключение "Дата должна быть ДД.ММ.ГГГГ или ГГГГ-ММ-ДД: " + Текст;
		КонецЕсли;
		Если Сред(Текст, 5, 1) = "-" И Сред(Текст, 8, 1) = "-" Тогда
			Результат = Дата(Число(Лев(Текст, 4)), Число(Сред(Текст, 6, 2)), Число(Сред(Текст, 9, 2)));
		ИначеЕсли Сред(Текст, 3, 1) = "." И Сред(Текст, 6, 1) = "." Тогда
			Результат = Дата(Число(Сред(Текст, 7, 4)), Число(Сред(Текст, 4, 2)), Число(Лев(Текст, 2)));
		Иначе
			ВызватьИсключение "Не распознана дата: " + Текст;
		КонецЕсли;
	КонецЕсли;
	Если Год(Результат) < 2000 Или Год(Результат) > 2099 Тогда
		ВызватьИсключение "Дата вне поддерживаемого диапазона 2000–2099.";
	КонецЕсли;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ЗаписьДокументов

&НаСервереБезКонтекста
Функция ЗагрузитьНаСервере(АдресФайла, Настройки)

	Отчет = НовыйРезультатЗагрузки();
	Отчет.ИмяФайла = Настройки.ПутьФайла;
	ИмяФайла = ПолучитьИмяВременногоФайла("xlsx");
	Попытка
		Контекст = ПолучитьКонтекстЗагрузки(Настройки);
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
		Если ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
			ВызватьИсключение "Не получены двоичные данные файла: " + Настройки.ПутьФайла;
		КонецЕсли;
		ДвоичныеДанные.Записать(ИмяФайла);
		ТабДок = ПрочитатьПервыйЛист(ИмяФайла);
		Строки = ПрочитатьСтроки(ТабДок, Отчет);
		Если Строки.Количество() = 0 Тогда
			Отчет.Примечания.Добавить("Нет корректных строк для загрузки.");
		Иначе
			Индекс = ПостроитьИндексКонтрагентов();
			ДокументыПоКлючам = ПрочитатьЗагруженныеДокументы(Строки, Контекст);
			КэшДоговоров = Новый Соответствие;
			Для Каждого Данные Из Строки Цикл
				ОбработатьСтроку(Данные, Контекст, Индекс, КэшДоговоров, ДокументыПоКлючам, Отчет);
			КонецЦикла;
		КонецЕсли;
	Исключение
		// Проведенные ранее строки сохраняются и обязательно включаются в отчет.
		Отчет.Примечания.Добавить("Загрузка остановлена: " + ОписаниеОшибки());
	КонецПопытки;
	УдалитьВременныйФайл(ИмяФайла);
	Попытка
		УдалитьИзВременногоХранилища(АдресФайла);
	Исключение
		Отчет.Примечания.Добавить("Не удалось очистить временное хранилище: " + ОписаниеОшибки());
	КонецПопытки;
	Возврат Новый Структура("Сводка,Отчет", СводкаЗагрузки(Отчет), СформироватьОтчет(Отчет));

КонецФункции

&НаСервереБезКонтекста
Процедура ОбработатьСтроку(Данные, Контекст, Индекс, КэшДоговоров, ДокументыПоКлючам, Отчет)

	Кандидаты = НайтиКонтрагента(Данные, Индекс);
	Если Кандидаты.Количество() > 1 Тогда
		ДобавитьПроблему(Отчет, Данные, "Пропущено", "Неоднозначный контрагент: " + ПредставитьСсылки(Кандидаты));
		Возврат;
	КонецЕсли;
	Контрагент = Неопределено;
	Если Кандидаты.Количество() = 1 Тогда
		Контрагент = Кандидаты[0];
	КонецЕсли;
	Существующие = ДокументыПоКлючам.Получить(Данные.Ключ);
	Если Существующие <> Неопределено Тогда
		Если Существующие.Количество() <> 1 Тогда
			ДобавитьПроблему(Отчет, Данные, "Пропущено", "Несколько документов с одним ключом: "
				+ ПредставитьСсылки(Существующие));
			Возврат;
		КонецЕсли;
		Попытка
			Документ = Существующие[0].ПолучитьОбъект();
			Причина = ПроверитьПовтор(Документ, Данные, Контекст, Контрагент);
			Если ПустаяСтрока(Причина) Тогда
				ДобавитьИтог(Отчет, "Уже загружено", Данные.Сумма);
				ДобавитьИсходноеСозданному(Отчет, Контрагент, Данные.ИсходноеИмя);
			Иначе
				ДобавитьПроблему(Отчет, Данные, "Пропущено", "Конфликт с " + Строка(Документ.Ссылка) + ": " + Причина);
			КонецЕсли;
		Исключение
			ДобавитьПроблему(Отчет, Данные, "Ошибка", ОписаниеОшибки());
		КонецПопытки;
		Возврат;
	КонецЕсли;

	НовыйКонтрагент = Неопределено;
	НачатьТранзакцию();
	Попытка
		Если Контрагент = Неопределено Тогда
			НовыйКонтрагент = СоздатьКонтрагента(Данные);
			Контрагент = НовыйКонтрагент.Ссылка;
		ИначеЕсли Контрагент.ПометкаУдаления Или Контрагент.ЭтоГруппа Тогда
			ВызватьИсключение "Найденный контрагент удален или стал группой.";
		КонецЕсли;
		Договор = КэшДоговоров.Получить(Контрагент);
		Если Договор = Неопределено Тогда
			Договор = ПолучитьДоговор(Контрагент, Контекст);
		КонецЕсли;
		Документ = СоздатьРеализацию(Данные, Контекст, Контрагент, Договор);
		Документ.Записать(РежимЗаписиДокумента.Проведение);
		// Проверяем именно записанный объект: типовые обработчики могут изменить его.
		Записанный = Документ.Ссылка.ПолучитьОбъект();
		Причина = ПроверитьПовтор(Записанный, Данные, Контекст, Контрагент);
		Если НЕ ПустаяСтрока(Причина) Тогда
			ВызватьИсключение "После записи документ отличается от реестра: " + Причина;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ОтменитьТранзакцию();
		// Индекс и кэш изменяются только ПОСЛЕ фиксации: ссылок на откатанные
		// контрагенты, договоры и документы в них не бывает.
		ДобавитьПроблему(Отчет, Данные, "Ошибка", ТекстОшибки);
		Возврат;
	КонецПопытки;

	ДобавитьИтог(Отчет, "Проведено", Данные.Сумма);
	Если НовыйКонтрагент <> Неопределено Тогда
		ДобавитьВИндекс(Индекс, НовыйКонтрагент.Ссылка, НовыйКонтрагент.Наименование,
			НовыйКонтрагент.НаименованиеПолное, НовыйКонтрагент.ИндивидуальныйПредприниматель);
		ЗарегистрироватьСозданного(Отчет, НовыйКонтрагент, Данные);
	КонецЕсли;
	ДобавитьКандидата(Индекс.Точные, НормализоватьИмя(Данные.ИсходноеИмя), Контрагент);
	КэшДоговоров.Вставить(Контрагент, Договор);
	ДобавитьКандидата(ДокументыПоКлючам, Данные.Ключ, Документ.Ссылка);
	ДобавитьИсходноеСозданному(Отчет, Контрагент, Данные.ИсходноеИмя);

КонецПроцедуры

&НаСервереБезКонтекста
Функция СоздатьКонтрагента(Данные)

	Разбор = Данные.Разбор;
	Если СтрДлина(Разбор.Имя) > Метаданные.Справочники.Контрагенты.ДлинаНаименования Тогда
		ВызватьИсключение "Очищенное имя длиннее допустимого наименования контрагента: " + Разбор.Имя;
	КонецЕсли;
	Объект = Справочники.Контрагенты.СоздатьЭлемент();
	Объект.Наименование = Разбор.Имя;
	Объект.НаименованиеПолное = Разбор.Имя;
	Объект.ИндивидуальныйПредприниматель = Разбор.ДанныеИмени.Форма = "ИП";
	Объект.ЮридическоеФизическоеЛицо = ?(Объект.ИндивидуальныйПредприниматель,
		Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо,
		Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо);
	Объект.СтранаРегистрации = Справочники.СтраныМира.Россия;
	Объект.Комментарий = "Автоматически создан загрузкой iiko. Исходное название: " + Данные.ИсходноеИмя;
	Если Разбор.ТипПоУмолчанию Тогда
		Объект.Комментарий = Объект.Комментарий + Символы.ПС
			+ "Тип юридическое лицо выбран по умолчанию. Требуется проверить тип и реквизиты.";
	КонецЕсли;
	Если НЕ Объект.ПроверитьЗаполнение() Тогда
		ВызватьИсключение "Не пройдена проверка заполнения нового контрагента " + Разбор.Имя;
	КонецЕсли;
	Объект.Записать();
	Возврат Объект;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДоговор(Контрагент, Контекст)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ Д.Ссылка, Д.Наименование,
		| НЕ Основной.Договор ЕСТЬ NULL КАК Основной
		|ИЗ Справочник.ДоговорыКонтрагентов КАК Д
		| ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОсновныеДоговорыКонтрагента КАК Основной
		| ПО Д.Ссылка = Основной.Договор И Д.Владелец = Основной.Контрагент
		| И Д.Организация = Основной.Организация И Д.ВидДоговора = Основной.ВидДоговора
		|ГДЕ Д.Владелец = &Контрагент И Д.Организация = &Организация
		| И Д.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПокупателем)
		| И Д.ВалютаВзаиморасчетов = &Валюта И НЕ Д.РасчетыВУсловныхЕдиницах
		| И НЕ Д.ЭтоГруппа И НЕ Д.ПометкаУдаления И НЕ Д.ДоговорЗакрыт");
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Организация", Контекст.ОрганизацияДоговора);
	Запрос.УстановитьПараметр("Валюта", Контекст.Валюта);
	Основные = Новый Массив;
	Все = Новый Массив;
	Iiko = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Все.Добавить(Выборка.Ссылка);
		Если Выборка.Основной Тогда
			Основные.Добавить(Выборка.Ссылка);
		КонецЕсли;
		Если НормализоватьИмя(Выборка.Наименование) = "ПРОДАЖИ IIKO" Тогда
			Iiko.Добавить(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	// Неоднозначность одноименных договоров не исчезает от наличия основного.
	Если Iiko.Количество() > 1 Тогда
		ВызватьИсключение "Несколько договоров Продажи iiko: " + ПредставитьСсылки(Iiko);
	КонецЕсли;
	Если Основные.Количество() = 1 Тогда
		Возврат Основные[0];
	ИначеЕсли Основные.Количество() > 1 Тогда
		ВызватьИсключение "Несколько основных договоров: " + ПредставитьСсылки(Основные);
	ИначеЕсли Все.Количество() = 1 Тогда
		Возврат Все[0];
	ИначеЕсли Iiko.Количество() = 1 Тогда
		Возврат Iiko[0];
	КонецЕсли;
	Договор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
	Договор.Владелец = Контрагент;
	Договор.Организация = Контекст.ОрганизацияДоговора;
	Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
	Договор.ВалютаВзаиморасчетов = Контекст.Валюта;
	Договор.Наименование = "Продажи iiko";
	Договор.Комментарий = "Автоматически создан загрузкой реестра iiko.";
	Если НЕ Договор.ПроверитьЗаполнение() Тогда
		ВызватьИсключение "Не пройдена проверка заполнения договора Продажи iiko.";
	КонецЕсли;
	Договор.Записать();
	Возврат Договор.Ссылка;

КонецФункции

